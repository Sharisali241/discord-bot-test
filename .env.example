# Discord bot token (required)
DISCORD_TOKEN=your_bot_token_here

# Command prefix (default: !)
PREFIX=!

# Optional: only users with this role can use stop, skip, volume, pause, remove, move (leave empty to allow everyone)
# DJ_ROLE=DJ

# Optional: cooldown in ms between play/add/random per user (0 = disabled)
# COOLDOWN_MS=0

# Optional: password to protect the web dashboard API (leave empty for no auth)
# WEB_PASSWORD=
